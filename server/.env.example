# Server configuration
# (Port 5001 is used by default because macOS Control Center / AirPlay occupies port 5000)
PORT=5001
NODE_ENV=development

# MongoDB Connection
# Set to your local MongoDB instance or MongoDB Atlas URI (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/relief_shield)
# In development, if local mongod is not detected, an in-memory MongoDB instance will automatically launch for demoing.
MONGODB_URI=mongodb://127.0.0.1:27017/relief_shield

# Authentication
# Used to sign and verify JSON Web Tokens (JWT) for secure authentication
JWT_SECRET=relief_shield_super_secure_jwt_secret_dev_key_2026

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173

# Image Storage: Cloudinary (Placeholder credentials)
# In development, if left as placeholders, uploads fall back to local preview/base64 mock
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Location Services: Google Maps API (Placeholder credential)
GOOGLE_MAPS_API_KEY=placeholder_google_maps_api_key
